# syntax=docker/dockerfile:1

FROM node:22.22.2-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HELMONIC_TENDER_ARTIFACT_ROOT=/var/lib/helmonic/tender-intelligence

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY scripts/tender_intelligence ./scripts/tender_intelligence
COPY src/lib/tender-intelligence ./src/lib/tender-intelligence

RUN mkdir -p /var/lib/helmonic/tender-intelligence && chown -R node:node /app /var/lib/helmonic
USER node
CMD ["node", "--experimental-strip-types", "scripts/tender_intelligence/run-daily-automation.mjs"]
