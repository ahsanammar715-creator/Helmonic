# Enables the Azure-backed Consult runtime. Leave unset for the unchanged UI-only deployment.
HELMONIC_RUNTIME=azure
HELMONIC_APP_VERSION=local
HELMONIC_DEMO_PROFILE=iAcoustics
HELMONIC_ALLOW_RETRIEVAL_ONLY=true

# Existing Phase 1A DEV resources (resource names/endpoints are configuration, not secrets).
AZURE_SEARCH_ENDPOINT=https://srch-helmonic-dev-001.search.windows.net
AZURE_SEARCH_INDEX=consult-demo-v1
AZURE_SEARCH_API_VERSION=2025-09-01
HELMONIC_HYBRID_RETRIEVAL_ENABLED=false
HELMONIC_SEARCH_VECTOR_K=50
HELMONIC_SEARCH_SEMANTIC_ENABLED=false
AZURE_SEARCH_SEMANTIC_CONFIGURATION=consult-semantic-v2
# Candidate cutoffs are committed with the evaluation fixture and must be tuned on v2.
HELMONIC_SEARCH_MIN_SEMANTIC_SCORE=2
HELMONIC_SEARCH_MIN_RRF_SCORE=0.015
AZURE_STORAGE_ACCOUNT=sthelmonicdev001
AZURE_KEY_VAULT_URL=https://kv-helmonic-dev-001.vault.azure.net
AZURE_POSTGRES_HOST=psql-helmonic-dev-001.postgres.database.azure.com
AZURE_POSTGRES_DATABASE=helmonic_consult_dev
AZURE_POSTGRES_USER=ca-helmonic-consult-dev-002
AZURE_POSTGRES_PORT=5432
AZURE_SERVICE_BUS_NAMESPACE=sb-helmonic-dev-001.servicebus.windows.net
AZURE_SERVICE_BUS_QUEUE=consult-ingestion

# Phase 1B remains fail-closed until its migration, container/index and worker are
# separately approved and deployed. Keep these false/unset in Vercel and current DEV.
HELMONIC_PHASE1B_UPLOADS_ENABLED=false
HELMONIC_PHASE1B_FOLDERS_ENABLED=false
HELMONIC_GENERAL_CONTEXT_ENABLED=false
AZURE_STORAGE_SESSION_CONTAINER=consult-session-uploads
AZURE_SEARCH_SESSION_INDEX=
HELMONIC_MAX_UPLOAD_BYTES=41943040
HELMONIC_UPLOAD_RETENTION_DAYS=30

# Restricted email evidence is held in a separate Search index and queried only
# with its dedicated reader identity after the caller passes the leadership gate.
HELMONIC_EMAIL_EVIDENCE_ENABLED=false
AZURE_EMAIL_SEARCH_ENDPOINT=
AZURE_EMAIL_SEARCH_INDEX=consult-email-relationship-restricted-v1
AZURE_EMAIL_SEARCH_CLIENT_ID=
HELMONIC_EMAIL_LEADERSHIP_OBJECT_IDS=
HELMONIC_EMAIL_LEADERSHIP_GROUP_IDS=
HELMONIC_EMAIL_RETENTION_YEARS=7

# Optional free-tier PlanningLeads discovery enrichment. PlanningLeads records
# remain discovery-only until authoritative council documents pass the evidence gate.
HELMONIC_PLANNINGLEADS_ENABLED=false
PLANNINGLEADS_API_ENDPOINT=https://planningleads.ie/api/v1
PLANNINGLEADS_API_KEY=
HELMONIC_PLANNINGLEADS_PAGE_SIZE=100
HELMONIC_PLANNINGLEADS_CACHE_HOURS=12

# Add these after explicitly choosing and creating the smallest suitable model deployment.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_REASONING_EFFORT=high
AZURE_OPENAI_MAX_COMPLETION_TOKENS=2000
AZURE_OPENAI_TIMEOUT_MS=120000

# Hybrid retrieval remains disabled until the separately approved embedding deployment,
# consult-demo-v2 re-index, parity check, and private evaluation all pass.
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
AZURE_OPENAI_EMBEDDING_TIMEOUT_MS=30000

# Target B checks the four dependencies it uses. Add `model` only after a deployment is approved.
HELMONIC_READINESS_CHECKS=search,postgres,blob,keyvault
HELMONIC_BUILDINGINFO_ENABLED=false
BUILDINGINFO_API_ENDPOINT=https://api12.buildinginfo.com/api/v2/bi/projects/t-projects_1.4
BUILDINGINFO_API_KEY=
BUILDINGINFO_USER_KEY=
HELMONIC_BUILDINGINFO_UPDATE_WINDOW=0.7
HELMONIC_BUILDINGINFO_PAGE_SIZE=1000
HELMONIC_BUILDINGINFO_MAX_PAGES=50

# Persistent worker state. Mount this directory from private durable storage in production.
HELMONIC_TENDER_ARTIFACT_ROOT=
HELMONIC_RELATIONSHIP_INDEX_DIR=

# Odoo synchronization stays fail-closed until the test database contract is confirmed.
HELMONIC_ODOO_SYNC_ENABLED=false
HELMONIC_ODOO_PREFLIGHT_ONLY=false
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_API_KEY=
ODOO_MODEL=crm.lead
ODOO_EXTERNAL_ID_FIELD=x_helmonic_external_id
ODOO_SALES_TEAM_ID=
ODOO_INITIAL_STAGE_ID=
ODOO_GLEN_USER_ID=
ODOO_EOGHAN_USER_ID=
ODOO_TIMEOUT_MS=30000
