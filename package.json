    "test:model-policy": "node --experimental-strip-types --test --experimental-test-isolation=none scripts/evaluation/model-answer-policy.test.mjs",
    "test:email-query": "node --experimental-strip-types --test --experimental-test-isolation=none scripts/evaluation/email-query-policy.test.mjs",
    "test:tender-intelligence": "node --experimental-strip-types --test --experimental-test-isolation=none scripts/tender_intelligence/official-sources.test.mjs",
    "run:tender-intelligence": "node --experimental-strip-types scripts/tender_intelligence/run-document-proven-pipeline.mjs",
