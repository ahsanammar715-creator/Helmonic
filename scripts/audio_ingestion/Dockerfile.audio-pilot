FROM node:22.22.1-alpine3.23

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
  && npm cache clean --force

COPY scripts/managed-identity.mjs ./scripts/managed-identity.mjs
COPY scripts/audio_ingestion ./scripts/audio_ingestion
COPY payload /payload

USER node

CMD ["node", "scripts/audio_ingestion/upload-audio-pilot.mjs"]
