FROM node:22.22.1-alpine3.23

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
  && npm cache clean --force

COPY scripts/managed-identity.mjs ./scripts/managed-identity.mjs
COPY scripts/ingestion/standing-worker-proof-contract.mjs ./scripts/ingestion/standing-worker-proof-contract.mjs
COPY scripts/ingestion/probe-standing-worker.mjs ./scripts/ingestion/probe-standing-worker.mjs

USER node

CMD ["node", "scripts/ingestion/probe-standing-worker.mjs"]
